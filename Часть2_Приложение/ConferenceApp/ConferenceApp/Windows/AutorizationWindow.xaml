<Window x:Class="ConferenceApp.Windows.AutorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConferenceApp.Windows"
        mc:Ignorable="d"
        Title="Вход" Height="350" Width="400"
        FontFamily="Calibri" FontSize="14"
        MinHeight="200" MinWidth="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <!--Будем показывать и скрывать капчу при неудачном входе-->
            <RowDefinition x:Name="RowCaptcha1" Height="34"/>
            <RowDefinition x:Name="RowCaptcha2"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource additional}"/>
        <TextBlock Grid.Row="0" Text="Организация мероприятий"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource main}" FontSize="20" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Style="{StaticResource item_textblock}" Text="IdNumber"
                       Margin="20 0" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="TbLogin" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Style="{StaticResource item_textblock}" Text="Пароль"
                       Margin="20 0" VerticalAlignment="Center" Width="120"/>
            <PasswordBox x:Name="TbPass" Height="30" Width="200" VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <TextBlock Style="{StaticResource item_textblock}" Text="Введите капчу"
                       Margin="20 0" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="TbCaptcha" Width="200"/>
        </StackPanel>
        <Image Grid.Row="4" x:Name="ImageCaptcha" Height="100" Width="300" VerticalAlignment="Top"/>
        <Button Width="24" Height="24" Padding="0" Content="↻"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                x:Name="BtnRenewCaptcha" Click="BtnRenewCaptcha_Click" Grid.Row="3"/>
        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Center">
            <Button Width="100" Content="OK" x:Name="BtnOk" Click="BtnOkClick" IsDefault="True"/>
            <Button Width="100" Content="Cancel" x:Name="BtnCancel" Click="BtnCancelClick"/>
        </StackPanel>
        <TextBlock Style="{StaticResource item_textblock}" Grid.Row="4" x:Name="TextBlockTime"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="326"/>
    </Grid>
</Window>
