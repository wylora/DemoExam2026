<Window x:Class="ConferenceApp.Windows.AddJuryModeratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConferenceApp.Windows"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Регистрация жюри/модератора" WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" FontSize="14"
        Height="500" Width="800" MinHeight="500" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource additional}" Grid.ColumnSpan="4"/>
        <TextBlock Grid.Row="0" Text="Регистрация жюри/модератора" Grid.ColumnSpan="4"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource main}" FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="1" Text="Id Number:" Style="{StaticResource add_window_textblock}"/>
        <TextBox x:Name="TextBoxIdNumber" Grid.Row="1" Grid.Column="1"
                 IsReadOnly="True" Background="LightGray"/>

        <TextBlock Grid.Row="2" Text="ФИО:" Style="{StaticResource add_window_textblock}"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="TextBoxSurname" Width="100"/>
            <TextBox x:Name="TextBoxName" Width="100"/>
            <TextBox x:Name="TextBoxPatronymic" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Пол:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboBoxGender" Grid.Row="3" Grid.Column="1">
            <ComboBoxItem Content="женский"/>
            <ComboBoxItem Content="мужской"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Дата рождения:" Style="{StaticResource add_window_textblock}"/>
        <DatePicker x:Name="DatePickerBirthday" Grid.Column="1" Grid.Row="4"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="5" Text="Роль:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboBoxRole" Grid.Row="5" Grid.Column="1">
            <ComboBoxItem Content="модератор"/>
            <ComboBoxItem Content="жюри"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Text="Email:" Style="{StaticResource add_window_textblock}"/>
        <TextBox x:Name="TextBoxEmail" Grid.Row="6" Grid.Column="1"/>

        <TextBlock Grid.Row="7" Text="Телефон:" Style="{StaticResource add_window_textblock}"/>
        <xctk:MaskedTextBox x:Name="MaskedTextBoxPhone" Grid.Row="7" Grid.Column="1"
                            Mask="+0(000)-000-00-00" FontSize="16" FontWeight="Bold"/>

        <TextBlock Grid.Row="8" Text="Страна:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboCountry" Grid.Row="8" Grid.Column="1"
                  DisplayMemberPath="Title" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="9" Text="Направление:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboCourse" Grid.Row="9" Grid.Column="1"
                  DisplayMemberPath="CourseTitle" SelectedValuePath="Id"/>

        <CheckBox x:Name="CheckBoxAttachToEvent" Grid.Row="10" Grid.Column="1"
                  VerticalAlignment="Center" Margin="10 0 0 0" Content="Прикрепить к мероприятию"
                  Checked="CheckBoxAttachToEvent_Checked" Unchecked="CheckBoxAttachToEvent_Unchecked"/>

        <TextBlock Grid.Row="11" Text="Мероприятие:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboEvent" Grid.Row="11" Grid.Column="1"
                  DisplayMemberPath="Title" SelectedValuePath="Id"
                  SelectionChanged="ComboEvent_SelectionChanged"/>

        <TextBlock Grid.Row="12" Text="Активность:" Style="{StaticResource add_window_textblock}"/>
        <ComboBox x:Name="ComboActivity" Grid.Row="12" Grid.Column="1"
                  DisplayMemberPath="Title" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="10" Grid.Column="2" Text="Пароль:" Style="{StaticResource add_window_textblock}"/>
        <PasswordBox x:Name="PasswordBoxFirst" Grid.Row="10" Grid.Column="3" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TextBoxPasswordFirst" Visibility="Collapsed" Grid.Row="10" Grid.Column="3"/>

        <TextBlock Grid.Row="11" Grid.Column="2" Text="Повтор пароля:" Style="{StaticResource add_window_textblock}"/>
        <PasswordBox x:Name="PasswordBoxAgain" Grid.Row="11" Grid.Column="3" VerticalContentAlignment="Center"/>
        <TextBox x:Name="TextBoxPasswordAgain" Visibility="Collapsed" Grid.Row="11" Grid.Column="3"/>

        <CheckBox x:Name="CheckBoxIsVisiblePassword" Grid.Row="12" Grid.Column="3"
                  VerticalAlignment="Center" Margin="10 0 0 0" Content="Видимый пароль"
                  Checked="CheckBoxIsVisiblePassword_Checked" Unchecked="CheckBoxIsVisiblePassword_Unchecked"/>

        <Image x:Name="ImageUserPhoto" Grid.Row="1" Grid.Column="3" Grid.RowSpan="7"/>
        <Button x:Name="ButtonLoadPhoto" Grid.Column="3" Grid.Row="8" Width="140"
                HorizontalAlignment="Right" Content="Фото..." Click="ButtonLoadPhoto_Click"/>

        <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.Column="3" HorizontalAlignment="Center">
            <Button Width="100" Content="OK" x:Name="BtnOk" Click="BtnOk_Click"/>
            <Button Width="100" Content="Отмена" x:Name="BtnCancel" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
