<Window x:Class="ConferenceApp.Windows.OrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConferenceApp.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource base_window}"
        Title="Окно организатора" Height="450" Width="800"
        Closed="Window_Closed" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource additional}"/>
        <Image Margin="10" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="0" Text="Окно организатора"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource main}" FontSize="20" FontWeight="Bold"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Image x:Name="ImagePhoto" Height="300"/>
                <Button Content="Мой профиль"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TextBlockDayTime" Height="30" FontSize="18"
                           Foreground="{StaticResource additional}"/>
                <TextBlock x:Name="TextBlockUserName" Height="30" FontSize="18"
                           Foreground="{StaticResource additional}"/>
                <Button Content="Мероприятия"/>
                <Button Content="Участники"/>
                <Button Content="Жюри"/>
                <Button x:Name="ButtonAddJuryModerator"
                        Content="Зарегистрировать жюри/модератора"
                        Click="ButtonAddJuryModerator_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Background="{StaticResource additional}"/>
    </Grid>
</Window>
